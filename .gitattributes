# Normalise line endings for text files.
* text=auto eol=lf

*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# The licence text must keep its exact bytes.
LICENSE text eol=lf
NOTICE  text eol=lf

# Screenshots are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif  binary
*.webp binary
