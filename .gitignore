# Local checkout of the audited bot — never commit it.
# مثبّت على الجذر: بدون / كان يستثني أي مجلد يحمل الاسم نفسه،
# ومنها evidence/<subject>/ و subjects/<subject>/.
/wa-booking-bot/
/BOT_REPO/
*.bot/

audit.config.json
.env.audit

# Environment and secrets
.env
.env.*
!.env.example

# The audited bot's runtime data
data/
*.db
*.db-*
*.lock
*.secret-key

# Receipts, invoices and backups of the audited system
receipts/
invoices/
backups/
*.pdf

# Node
node_modules/
npm-debug.log*

# Editors and OS noise
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.swp

# Logs and crash dumps
*.log
hs_err_pid*

# Scratch
tmp/
scratch/
*.tmp
